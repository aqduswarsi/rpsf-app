{
  "expo": {
    "name": "rpsf-app",
    "slug": "rpsf-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vanshtiwa.rpsfapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#EAF4FC",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "f8ac2f70-7c7f-4ddf-a11e-9c3f27e24230"
      }
    }
  }
}
